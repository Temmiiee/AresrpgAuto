# AresRPG bot runtime configuration. Copy to `.env` and fill in. Bun auto-loads `.env` from
# this package directory (the cwd `bun run bot` uses). Gameplay/network settings are centralized in
# `src/config.ts` and `src/shared/network_config.ts`; logger settings live in `src/shared/logger.ts`.
# `BOT_PROFILE_PREVIEW` is a standalone fight-planner diagnostic read by the planner modules.

# ---- network ---------------------------------------------------------------
# "mainnet" (default) or "testnet".
SUI_NETWORK=mainnet
# Optional RPC override; defaults to the public fullnode for SUI_NETWORK.
#SUI_RPC_URL=

# ---- endpoints -------------------------------------------------------------
#ARES_SERVER_WS_URL=wss://server.aresrpg.world/
#ARES_ORIGIN=https://aresrpg.world

# ---- Discord ---------------------------------------------------------------
# Discord webhook URL. When unset, every notification is silently skipped.
DISCORD_WEBHOOK_URL=
# Optional role/user mention prepended to every notification so a phone actually buzzes.
#DISCORD_MENTION=
# Minutes between the party-wide progress digest (0 disables it). Loot is decoded from settlement
# events; gathered/crafted count successful actions only. A startup message and a fatal-crash
# message are always posted. Default 60 (hourly).
#BOT_DIGEST_MINUTES=60

# ---- zkLogin ---------------------------------------------------------------
# Optional: override the Enoki API key / Google client id the public frontend ships. The key is
# network-scoped, so a mainnet run may need a different one.
#ENOKI_API_KEY=
#ENOKI_GOOGLE_CLIENT_ID=
# Local port for the interactive sign-in capture page (default 5173).
#ENOKI_LOGIN_PORT=5173
# How long to wait for the interactive Google sign-in, in ms (default 1800000 = 30 min).
#ENOKI_LOGIN_TIMEOUT_MS=1800000

# ---- play toggles (defaults come from the selected module) ----------------
BOT_GATHER=true
BOT_FIGHT=true
BOT_ROAM=true
BOT_CRAFT=true
# Feed every eligible pet once per UTC day. Pet food is added to craft/gather objectives when its
# authored ingredients and job level make progress possible (default true).
#BOT_PET_FEED=true
# Fight as ONE party: the leader engages and every other character joins the same fight.
#BOT_GROUP=true
# Let the cross-world gatherer periodically detach for a richer resource world.
#BOT_CROSS_WORLD=true
# Allow the general profile to create new dungeon runs (default true). Specialized profiles default
# to false so keys, previews and portal travel cannot interrupt their single objective. An already
# committed run is always recovered safely even when this toggle is false.
#BOT_DUNGEON=true

# ---- specialized bot module -----------------------------------------------
# The normal command uses `general`. Prefer the dedicated commands below; they set these variables
# for this process without requiring edits to `.env`:
#   bun run bot:xp [character] [target-level]
#   bun run bot:job <FARMER|HERBALIST|MINER|FORGER|CARVER|TAILOR|JEWELER|TANNER|HANDYMAN|ALCHEMIST|BAKER> [character] [target-level]
#   bun run bot:craft <item-type> [quantity] [character]
#
# `xp` removes chores, inventory transactions, pets and dungeons; it keeps group combat, roaming
# and the XP/turn strategy scan. `job` assigns the exact profession to one character: a gathering
# profession idles the other characters, while a crafting profession retains fixed-job gatherers
# and combat only when they can supply recipe ingredients. `craft` makes one output the only craft
# objective and stops starting actions as soon as the requested owned quantity exists.
#BOT_MODULE=general
#BOT_MODULE_CHARACTER=omori
#BOT_XP_TARGET_LEVEL=50
#BOT_JOB_TARGET=TAILOR
#BOT_JOB_TARGET_LEVEL=80
#BOT_CRAFT_TARGET=silkblade_thread
#BOT_CRAFT_QUANTITY=1

# ---- party -----------------------------------------------------------------
# How many roster characters to drive at once (1-5, default 5). All share ONE websocket: the
# server seats one socket per address, so per-character processes would evict each other.
#BOT_PARTY_SIZE=5
# Character name that opens the party's shared fights (default omori).
#BOT_LEADER=omori
# Optional independent coordinated teams. First character in each array leads that team. Each team
# gets its own rendezvous, dungeon state and farm strategy while sharing the single account socket
# and inventory. Keep the total at or below BOT_PARTY_SIZE (max 5).
# Example: Tomoda + Mori support squad, Yogan + two gatherers as another squad:
#BOT_TEAMS=[["tomoda_name","mori_name"],["yogan_name","memorien","llokan"]]

# ---- chores ----------------------------------------------------------------
# Per-character chore plan: a JSON map of (lowercased) character name -> role. Roles:
#   "craft" | "none" | "gather_all" | "gather_all_craft"
#   "FARMER" | "HERBALIST" | "MINER"                         (gather one job)
#   {"kind":"gather_craft","job":"HERBALIST"}                (gather one job + craft)
# Default: one dedicated crafter and one fixed job/tool per gatherer. This concentrates craft XP and
# prevents gas-heavy tool swaps. The *_all roles remain available only for explicit custom plans.
#BOT_CHORE_PLAN={"omori":"craft","memorien":"FARMER","llokan":"MINER","archero":"HERBALIST"}
# Every settled group fight schedules one bounded chore attempt for each party member before the
# next rendezvous. This interval is the additional no-fight retry floor: per-character in solo mode,
# leader-owned in group mode (0 disables the floor). Default 300000 (5 min).
#BOT_CHORE_INTERVAL_MS=300000
# Character that detaches for cross-world gathering (default archero).
#BOT_CROSS_WORLD_GATHERER=archero
# Explicit cross-world target world; unset = the richest reachable resource world.
#BOT_CROSS_WORLD_WORLD=
# Ms between cross-world trips (0 disables the cycle). 0 keeps every party seat home and fighting.
# Default 1800000 (30 min).
#BOT_CROSS_WORLD_INTERVAL_MS=1800000
# Ms the detacher spends gathering before returning (default 600000 = 10 min).
#BOT_CROSS_WORLD_DWELL_MS=600000

# ---- strategy brain --------------------------------------------------------
# Periodic whole-content pass: reranks every mob family in the fight world into the block distance
# whose likely group pays the most XP/turn for THIS party, names the best wearable per slot and its
# acquisition route, and folds wanted gear upgrades into the gather demand (preferring families that
# drop them). Console-only — it never sends a Discord message. The first full pass is delayed by up
# to 90 seconds so characters can connect and take their first actions; the scan runs in a worker.
#BOT_STRATEGY=true
# Ms between strategy passes (0 runs once at startup). Default 1800000 (30 min).
#BOT_STRATEGY_INTERVAL_MS=1800000

# ---- game content updates --------------------------------------------------
# Compare game seed data and combat/progression Move rules with aresrpg/aresrpg:edge starting
# 60 seconds after startup and then every 6 hours. Drift is logged and sent to Discord when
# DISCORD_WEBHOOK_URL is configured;
# synchronize the local game snapshot and restart to apply changed balance or rules.
BOT_CONTENT_WATCH=true
#BOT_CONTENT_WATCH_INTERVAL_MS=21600000

# ---- combat analytics ------------------------------------------------------
# Write per-fight JSONL checkpoints and submitted actions to logs/fights/ (default false).
BOT_COMBAT_ANALYTICS=false

# ---- console logging and diagnostics --------------------------------------
# Default info shows startup, successful actions, meaningful waits/holds, and warnings. Use debug
# for decision details or trace for every awaited decision step. `silent` hides app logs, but SDK
# `tx` lines are written directly to the console and remain visible.
#BOT_LOG_LEVEL=info
# Optional per-scope overrides, e.g. "party=debug,trace=trace,health=info".
#BOT_LOG_SCOPES=
# Legacy shortcut: treated as BOT_LOG_LEVEL=debug only if BOT_LOG_LEVEL is unset.
#BOT_DEBUG=
# Extra local fight-preview timing output; independent of BOT_LOG_LEVEL. Leave unset for normal runs.
#BOT_PROFILE_PREVIEW=1

# ---- misc ------------------------------------------------------------------
# Optional: pin the exact character (0x…) and world the bot farms.
#ARES_CHARACTER_ID=
#ARES_WORLD=nauvis
# Milliseconds between idle decision passes (default 3000).
#BOT_IDLE_SLEEP_MS=3000
# Durable state directory for the ledger + pending-transaction records (default .state).
#BOT_STATE_DIR=.state
