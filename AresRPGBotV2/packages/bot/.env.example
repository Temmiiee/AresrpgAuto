# AresRPG bot runtime configuration. Copy to `.env` and fill in. Bun auto-loads `.env` from
# this package directory (the cwd `bun run bot run` uses). Only these variables are read;
# config.ts is the single seam that reads process.env.

# "mainnet" (default) or "testnet".
SUI_NETWORK=mainnet

# Discord webhook URL. When unset, every notification is silently skipped.
DISCORD_WEBHOOK_URL=

# Optional role/user mention prepended to every notification so a phone actually buzzes.
#DISCORD_MENTION=

# How often to post the party-wide progress digest to Discord, in minutes (0 disables it).
# The bot still always posts a startup message and a fatal-crash message. Default 60 (hourly).
#BOT_DIGEST_MINUTES=60

# Play toggles. Each defaults to true when absent.
BOT_GATHER=true
BOT_FIGHT=true
BOT_ROAM=true
BOT_CRAFT=true

# How many roster characters to drive at once (1-4, default 4). All share ONE websocket: the
# server seats one socket per address, so per-character processes would evict each other.
#BOT_PARTY_SIZE=4

# Optional: pin the exact character (0x…) and world the bot farms.
#ARES_CHARACTER_ID=
#ARES_WORLD=

# Optional: milliseconds between idle decision passes (default 5000).
#BOT_IDLE_SLEEP_MS=5000

# Optional: endpoint overrides.
#SUI_RPC_URL=
#ARES_SERVER_WS_URL=
#ARES_ORIGIN=
