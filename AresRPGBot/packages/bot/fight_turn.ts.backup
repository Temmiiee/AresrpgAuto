// Simplified fight turn handler focused on speed and minimal gas usage
// Core loop: observe state → get RL decision → execute action → repeat
import { create_fight, type FightCommand } from '@aresrpg/fight'

import type { BotSdk } from '../auth/sdk_client.ts'
import { CHARACTERS } from '../config/party_config.ts'
import { message_of, sleep, submit_with_retry, is_transient } from '../shared/chain_retry.ts'
import { as_number, read_fight, type FightJson, type FighterJson } from './fight_state.ts'
import type { PartyPrep } from './fight_progression.ts'

// Simple helper to get a decision from the RL system via subprocess
async function getRLDecision(stateJson: any): Promise<{ action: FightCommand | null } | null> {
  try {
    // Check if we can spawn Python processes
    const pythonAvailable = typeof process !== 'undefined' && process.env.VSCODE_PID === undefined

    if (!pythonAvailable) {
      return null
    }

    // Spawn Python decision service
    const { spawn } = await import('child_process')
    const { resolve } = await import('path')

    // Get ARES_RPG_ROOT from environment or use relative path
    const aresRpgRoot = process.env.ARES_RPG_ROOT ||
                       resolve(__dirname, '../../..', 'AresRPG-RL')
    const scriptPath = resolve(aresRpgRoot, 'rl/decide_service.py')

    const pythonProcess = spawn('python3', [scriptPath], {
      stdio: ['pipe', 'pipe', 'pipe']
    })

    // Send state and wait for response
    return new Promise((resolve) => {
      let resultData = ''
      let errorData = ''

      pythonProcess.stdout.on('data', (data) => {
        resultData += data.toString()
      })

      pythonProcess.stderr.on('data', (data) => {
        errorData += data.toString()
      })

      pythonProcess.on('close', (code) => {
        if (code === 0 && resultData.trim()) {
          try {
            const parsed = JSON.parse(resultData.trim())
            if (parsed.ok && parsed.best_action !== null) {
              resolve({ action: parsed.best_action })
            } else {
              resolve(null)
            }
          } catch (e) {
            resolve(null)
          }
        } else {
          resolve(null)
        }
      })

      // Send the state
      pythonProcess.stdin.write(JSON.stringify({ state: stateJson }) + '\n')
      pythonProcess.stdin.end()

      // Timeout after 2 seconds
      setTimeout(() => {
        if (!pythonProcess.killed) {
          pythonProcess.kill()
          resolve(null)
        }
      }, 2000)
    })
  } catch (error) {
    // If anything goes wrong, return null to fall back to basic behavior
    return null
  }
}

/** Decides and commits exactly one acting character's turn using simplified logic:
 *  - Tries to get a decision from the RL system (via subprocess)
 *  - Falls back to basic behavior (strike nearest enemy or move toward them)
 *  - Optimized for speed and minimal gas usage */
const decide_and_commit_turn = async (
  bot: BotSdk,
  fight_id: string,
  state_json: FightJson,
  turn: number,
  acting_idx: number,
  acting: (typeof CHARACTERS)[number],
  acting_fighter: FighterJson,
  prep: PartyPrep,
  log: (msg: string) => void
): Promise<void> => {
  const { fight } = bot
  const my_team = acting_fighter.team

  // Get living enemies
  const living_enemies = state_json.fighters
    .map((f, idx) => ({ ...f, idx }))
    .filter((f) => f.team !== my_team && as_number(f.hp) > 0)

  // If no enemies left, pass turn
  if (living_enemies.length === 0) {
    await submit_with_retry(() => fight.commit_turn({ fight: fight_id, actions: [] }), log)
    return
  }

  // Try to get RL decision first
  let rlAction: FightCommand | null = null

  try {
    const rlResult = await getRLDecision(state_json)
    if (rlResult && rlResult.action) {
      rlAction = rlResult.action
    }
  } catch (error) {
    // If RL decision fails, we'll fall back to basic behavior
    log(`RL decision unavailable: ${message_of(error)}, using basic behavior`)
  }

  // If we have an RL action, execute it
  if (rlAction) {
    try {
      // Check if this action would end the fight
      const wouldEndFight = await checkIfActionEndsFight(bot, fight_id, rlAction, state_json)

      await submit_with_retry(
        () => fight.commit_turn({ fight: fight_id, actions: [rlAction], ended: wouldEndFight }),
        log
      )

      // Log the action taken
      let actionDesc = 'unknown action'
      if (rlAction.type === 'move_to') {
        actionDesc = `moved (${rlAction.path.length} cells)`
      } else if (rlAction.type === 'cast_spell') {
        actionDesc = `cast ${rlAction.spell}`
      } else if (rlAction.type === 'weapon_strike') {
        actionDesc = 'struck'
      }

      log(`turn ${turn}: ${acting.name} ${actionDesc}`)
      return
    } catch (error) {
      if (!is_transient(error)) {
        log(`RL action failed: ${message_of(error)}, falling back to basic behavior`)
      }
      // Fall through to basic behavior
    }
  }

  // Fallback: basic behavior - strike nearest enemy or move toward them
  const my_cell = BigInt(as_number(state_json.fighters[acting_idx]!.cell))
  const enemy_cells = living_enemies.map(f => BigInt(as_number(f.cell)))

  // Find nearest enemy
  let nearest_enemy_cell = enemy_cells[0]
  let min_distance = Number.MAX_SAFE_INTEGER

  for (const enemy_cell of enemy_cells) {
    const distance = Math.abs(Number(my_cell & 0xff - enemy_cell & 0xff)) +
                     Math.abs(Number((my_cell >> 8) & 0xff - (enemy_cell >> 8) & 0xff))
    if (distance < min_distance) {
      min_distance = distance
      nearest_enemy_cell = enemy_cell
    }
  }

  // Simple logic: if adjacent, strike; otherwise move toward enemy
  const distance_to_enemy = min_distance

  if (distance_to_enemy <= 1) {
    // Adjacent - strike
    try {
      await submit_with_retry(
        () => fight.commit_turn({
          fight: fight_id,
          actions: [{
            type: 'weapon_strike',
            fighter: BigInt(acting_idx),
            target_cell: nearest_enemy_cell
          }]
        }),
        log
      )
      log(`turn ${turn}: ${acting.name} struck nearest enemy`)
    } catch (error) {
      if (!is_transient(error)) {
        // If strike fails, try moving anyway
        await tryBasicMove(bot, fight_id, acting_idx, my_cell, nearest_enemy_cell, turn, acting, log)
      }
    }
  } else {
    // Not adjacent - move toward enemy
    await tryBasicMove(bot, fight_id, acting_idx, my_cell, nearest_enemy_cell, turn, acting, log)
  }
}

/** Try to make a basic move toward target cell */
async function tryBasicMove(
  bot: BotSdk,
  fight_id: string,
  acting_idx: number,
  my_cell: bigint,
  target_cell: bigint,
  turn: number,
  acting: typeof CHARACTERS[number],
  log: (msg: string) => void
): Promise<void> => {
  const { fight } = bot

  // Simple path finding: move one step toward target
  const my_x = Number(my_cell & 0xff)
  const my_y = Number((my_cell >> 8) & 0xff)
  const target_x = Number(target_cell & 0xff)
  const target_y = Number((target_cell >> 8) & 0xff)

  let move_x = my_x
  let move_y = my_y

  if (target_x > my_x) move_x = Math.min(my_x + 1, target_x)
  else if (target_x < my_x) move_x = Math.max(my_x - 1, target_x)

  if (target_y > my_y) move_y = Math.min(my_y + 1, target_y)
  else if (target_y < my_y) move_y = Math.max(my_y - 1, target_y)

  // If we're not moving, just pass
  if (move_x === my_x && move_y === my_y) {
    await submit_with_retry(() => fight.commit_turn({ fight: fight_id, actions: [] }), log)
    log(`turn ${turn}: ${acting.name} adjacent but couldn't strike, passing`)
    return
  }

  const move_cell = BigInt(move_x | (move_y << 8))
  const path = [move_cell]

  try {
    await submit_with_retry(
      () => fight.commit_turn({
        fight: fight_id,
        actions: [{
          type: 'move_to',
          fighter: BigInt(acting_idx),
          path
        }]
      }),
      log
    )
    log(`turn ${turn}: ${acting.name} moved toward enemy`)
  } catch (error) {
    if (!is_transient(error)) {
      log(`turn ${turn}: ${acting.name} move failed, passing`)
      await submit_with_retry(() => fight.commit_turn({ fight: fight_id, actions: [] }), log)
    }
  }
}

/** Check if an action would end the fight by simulating it */
async function checkIfActionEndsFight(
  bot: BotSdk,
  fight_id: string,
  action: FightCommand,
  state_json: FightJson
): Promise<boolean> => {
  try {
    // For simplicity, we'll assume most actions don't end the fight immediately
    // In a more sophisticated version, we could simulate the action
    // But for speed and simplicity, we'll return false for most actions
    // Only return true for obvious finishing moves (like striking when enemy is low HP)

    if (action.type === 'weapon_strike' || action.type === 'cast_spell') {
      // Check if target enemy would be killed
      const targetCell = action.target_cell
      if (targetCell !== null) {
        const targetFighter = state_json.fighters.find(f =>
          BigInt(as_number(f.cell)) === targetCell && as_number(f.hp) > 0
        )

        if (targetFighter) {
          const targetHp = as_number(targetFighter.hp)
          // Simple heuristic: if HP is low enough that a basic strike might kill
          // This is approximate but avoids complex simulation for speed
          return targetHp <= 8 // Assume average strike does ~8 damage
        }
      }
    }

    return false
  } catch (error) {
    // If we can't determine, assume it doesn't end fight
    return false
  }
}

export const run_turn_loop = async (
  bot: BotSdk,
  fight_id: string,
  prep: PartyPrep,
  log: (msg: string) => void
): Promise<{ final_state: FightJson; turns: number }> => {
  const { sdk, fight } = bot
  let final_state: FightJson | null = null
  let turns = 0

  for (let turn = 0; turn < 400; turn += 1) {
    const state_json = await read_fight(sdk, fight_id)
    if (state_json.ended) {
      final_state = state_json
      break
    }
    turns = turn + 1

    const acting_idx = as_number(state_json.queue[as_number(state_json.turn_ptr)]!)
    const acting_fighter = state_json.fighters[acting_idx]!
    const acting_character = acting_fighter.kind['@variant'] === 'Player' ? acting_fighter.kind.character : undefined
    const acting = CHARACTERS.find((c) => c.id === acting_character)

    if (!acting || as_number(acting_fighter.hp) <= 0) {
      await submit_with_retry(() => fight.commit_turn({ fight: fight_id, actions: [] }), log)
      await sleep(1_000) // Reduced sleep for faster turns
      continue
    }

    // Reduced wait time for faster response
    const turn_started_ms = as_number(state_json.turn_started_ms)
    const wait = turn_started_ms + 1_500 + 200 - Date.now() // 1.7s total wait
    if (wait > 0) await sleep(wait)

    await decide_and_commit_turn(bot, fight_id, state_json, turn, acting_idx, acting, acting_fighter, prep, log)
    await sleep(1_000) // Reduced sleep between turns
  }

  return { final_state: final_state ?? (await read_fight(sdk, fight_id)), turns }
}