# Network configuration
# Set to 'mainnet' or 'testnet' depending on where your characters are
# The characters in party_config.ts are on mainnet (as of 2026-09-11)
SUI_NETWORK=mainnet

# Optional: Custom RPC URL (defaults to public Sui nodes)
# SUI_RPC_URL=https://your-custom-rpc-url

# Optional: Enoki API key override for mainnet (if different from testnet key)
# ENOKI_API_KEY=your_enoki_api_key_here

# Optional: Session limits to prevent runaway gas costs
# MAX_CONSECUTIVE_LOSSES=5
# MAX_SESSION_GAS_SUI=1
